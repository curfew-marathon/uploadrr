# Copy to .env and fill in your paths:
#   cp .env.example .env
# .env is gitignored. Every variable has a ${VAR:-default} in docker-compose.yml,
# so the compose file still resolves with no .env - but the fallbacks are ./config
# and ./data in this checkout, not your real directories.

# ─────────────────────────────────────────────────────────────────────────────
# Host paths (required for real use)
# ─────────────────────────────────────────────────────────────────────────────

# Directory holding config.ini. Mounted read-only at /config, so uploadrr reads
# /config/config.ini.
#UPLOADRR_CONFIG_DIR=/srv/uploadrr/config

# Directory holding the album/archive tree uploadrr watches - importrr writes tar
# files here. Mounted at /data; config.ini's album_dir / archive_dir are paths
# under /data.
#UPLOADRR_DATA_DIR=/srv/uploadrr/data

# ─────────────────────────────────────────────────────────────────────────────
# Process identity / timezone
# ─────────────────────────────────────────────────────────────────────────────

# Passed through to the container. NOTE: the current image (plain python:alpine,
# no s6 init) does not act on PUID/PGID - the process runs as root regardless.
# Kept for parity with the previous compose file and a future base that honours them.
#PUID=1000
#PGID=1000

# Timezone for log timestamps, e.g. America/New_York, Europe/Berlin. tzdata is in
# the image; unset falls back to UTC.
#TZ=UTC

# ─────────────────────────────────────────────────────────────────────────────
# Optional (app defaults shown - uncomment only to change)
# ─────────────────────────────────────────────────────────────────────────────

#UPLOADRR_TAG=latest          # published image tag; ./start.sh --pull refreshes
#LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
#METRICS_ENABLED=true
#METRICS_PORT=9200            # Prometheus endpoint, served on the host
